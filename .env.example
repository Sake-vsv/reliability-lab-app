# Application identity
APP_SERVICE_NAME="Reliability Job Service"
APP_SERVICE_VERSION=0.1.0
APP_ENVIRONMENT=local

# Docker Compose project
COMPOSE_PROJECT_NAME=reliability-lab

# PostgreSQL local development configuration
POSTGRES_DB=reliability
POSTGRES_USER=reliability
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432

# Redis local development configuration
REDIS_PORT=6379

# Application connection URLs
APP_DATABASE_URL=postgresql+psycopg://reliability:local-development-only@127.0.0.1:5432/reliability
APP_REDIS_URL=redis://127.0.0.1:6379/0
